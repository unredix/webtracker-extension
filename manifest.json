{
  "name": "Web Activity Tracker",
  "description": "A browser extension to monitor and log user web activity.",
  "version": "1.1",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "idle", "storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "./popup/popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "./options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/gate.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
